root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# NC programs are kept exactly as written (encoding, line endings, spacing).
[*.nc]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
